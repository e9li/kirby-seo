{
    "name": "e9li/kirby-seo",
    "description": "Lightweight SEO tab, meta tags, Open Graph, robots.txt and sitemap.xml for Kirby",
    "type": "kirby-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Rafael Egli",
            "email": "rafael@e9li.com",
            "homepage": "https://www.e9li.com"
        }
    ],
    "support": {
        "docs": "https://github.com/e9li/kirby-seo/blob/main/README.md",
        "source": "https://github.com/e9li/kirby-seo",
        "issues": "https://github.com/e9li/kirby-seo/issues"
    },
    "keywords": [
        "kirby",
        "kirby-cms",
        "kirby-plugin",
        "seo",
        "open-graph",
        "robots",
        "sitemap"
    ],
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "getkirby/composer-installer": "^1.2"
    },
    "extra": {
        "installer-name": "seo"
    }
}
